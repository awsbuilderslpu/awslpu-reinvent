# Frontend Environment Configuration
# URL of the FastAPI backend (e.g., http://localhost:8000 or production API URL)
BACKEND_API_URL=http://localhost:8000

# Backend X-API-KEY secret for server-to-server calls
BACKEND_API_KEY=replace_with_your_backend_api_key

# Optional: Google Site Verification code
GOOGLE_SITE_VERIFICATION=

# Cloudflare Turnstile Public Site Key
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_public_site_key
